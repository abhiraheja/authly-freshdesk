{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (Trackly.Api)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: api",
      "program": "${workspaceFolder}/src/Trackly.Api/bin/Debug/net10.0/Trackly.Api.dll",
      "cwd": "${workspaceFolder}/src/Trackly.Api",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5210"
      }
    },
    {
      "name": "Frontend (Vite)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "Full stack (API + Frontend)",
      "configurations": ["API (Trackly.Api)", "Frontend (Vite)"],
      "stopAll": true
    }
  ]
}
