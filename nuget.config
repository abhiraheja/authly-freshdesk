<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Trackly only consumes packages from nuget.org.
    <clear /> drops any feeds inherited from machine- or user-level NuGet.Config
    (e.g. the private Saarvix Azure Artifacts feed), which would otherwise be
    queried on every restore and fail with NU1301 / 401 when its PAT expires.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
