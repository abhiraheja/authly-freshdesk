# Trackly self-hosted configuration — copy to `.env` next to
# docker-compose.self-host.yml, fill in the two required values, then:
#
#   docker compose -f docker-compose.self-host.yml up -d
#
# `.env` is git-ignored. Never commit a filled-in copy.

# ---- Required ---------------------------------------------------------------

# Postgres password for the bundled database.
POSTGRES_PASSWORD=change-me

# AES-256-GCM key protecting every secret Trackly stores (SMTP/IMAP passwords,
# SSO client secrets, OAuth tokens, connector signing keys). Base64, exactly 32
# bytes. Generate ONCE per deployment and back it up — if it is lost or changed,
# every previously encrypted value becomes permanently undecryptable.
#
#   openssl rand -base64 32
#   # PowerShell (works on both Windows PowerShell 5.1 and PowerShell 7):
#   $b = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
TRACKLY_MASTER_KEY=

# ---- Strongly recommended ---------------------------------------------------

# The URL people actually type in. Used to build links inside outbound email
# (magic links, invites, guest ticket tracking) and the SSO / mail-OAuth redirect
# URIs you register at your identity provider. Leave it as localhost and those
# links will point at localhost for everyone who receives them.
TRACKLY_PUBLIC_URL=http://localhost:8080

# Host header allow-list. Replace `*` with your real hostname in production.
TRACKLY_ALLOWED_HOSTS=*

# ---- Optional ---------------------------------------------------------------

# Host port the app is published on.
TRACKLY_PORT=8080

# Bundled Postgres database name and user.
POSTGRES_DB=trackly
POSTGRES_USER=trackly

# Anthropic API key. Empty ⇒ the AI copilot stays off everywhere.
ANTHROPIC_API_KEY=

# Deployment-level SMTP relay. Empty host ⇒ outbound mail is written to the log
# instead of sent. Per-workspace SMTP is configured inside the admin UI, and is
# the normal way to send mail — this is only the shared fallback.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@trackly.local
SMTP_FROM_NAME=Trackly
